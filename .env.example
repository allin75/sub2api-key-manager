# 管理页密码。默认值按需求为 111，正式使用时强烈建议修改。
ADMIN_PASSWORD=111

# Sub2API 普通账号，仅保存在 NAS 服务端，不会发送到浏览器。
SUB2API_BASE_URL=https://sub2api.yfyf.fun
SUB2API_EMAIL=your-email@example.com
SUB2API_PASSWORD=your-sub2api-password

# 日期统计时区
TIMEZONE=Asia/Shanghai

# 通过 HTTPS 反向代理访问时设为 true；直接使用 NAS HTTP 地址时保持 false。
COOKIE_SECURE=false

# 上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=15000
